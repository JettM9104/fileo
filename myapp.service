# /etc/systemd/system/fileo-api.service
# After editing: sudo systemctl daemon-reload && sudo systemctl enable --now fileo-api

[Unit]
Description=Gunicorn instance for Fileo API
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/var/www/fileo

# Load environment variables from a file (chmod 600 this file!)
EnvironmentFile=/var/www/fileo/.env

ExecStart=/var/www/fileo/venv/bin/gunicorn \
    --config gunicorn.conf.py \
    server:app

Restart=on-failure
RestartSec=5

# Harden the process
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
