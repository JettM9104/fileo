# .env — chmod 600 this file, never commit it to git
# Generate a secret key with: python -c "import secrets; print(secrets.token_hex(32))"

SECRET_KEY=replace-me-with-a-real-secret

# Supabase project credentials (served to the frontend via /config.js)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# Set to 1 when running behind Nginx / Heroku / any reverse proxy
# Ensures real client IPs are used for rate limiting (not the proxy IP)
BEHIND_PROXY=0

# Comma-separated list of allowed origins for CORS (leave unset if not needed)
# ALLOWED_ORIGINS=https://example.com,https://www.example.com

# Set to 1 only if Flask is terminating SSL directly (not needed behind Nginx)
FORCE_HTTPS=0

# Optional: swap memory:// for Redis to persist rate limit state across restarts
# RATELIMIT_STORAGE_URL=redis://localhost:6379
